{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "devCommand": "bun run build && bun x vite preview --port $PORT",
  "redirects": [
    {
      "source": "/pages/volunteer.html",
      "destination": "/pages/get-involved.html",
      "permanent": false
    },
    {
      "source": "/pages/volunteer",
      "destination": "/pages/get-involved.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/v/:slug",
      "destination": "/api/v/:slug"
    },
    {
      "source": "/s/:id",
      "destination": "/api/v/s-:id"
    },
    {
      "source": "/discover",
      "destination": "/api/v/discover"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/v/category-:slug"
    },
    {
      "source": "/shelf/:id",
      "destination": "/api/v/shelf-:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/og/:slug.png",
      "destination": "/api/og/:slug"
    },
    {
      "source": "/v1/items",
      "destination": "/api/items?audience=keyed"
    },
    {
      "source": "/api/auth",
      "destination": "/api/account?area=auth"
    },
    {
      "source": "/api/boards",
      "destination": "/api/account?area=boards"
    },
    {
      "source": "/img/:source/:id/:tier",
      "destination": "/api/img/:source/:id/:tier"
    }
  ],
  "crons": [
    {
      "path": "/api/cron?job=restore-drill-reminder",
      "schedule": "11 9 1 1,4,7,10 *"
    },
    {
      "path": "/api/cron?job=db-backup",
      "schedule": "27 7 1 * *"
    },
    {
      "path": "/api/cron?job=db-backup&task=reshuffle",
      "schedule": "41 3 * * *"
    },
    {
      "path": "/api/cron?job=health-check",
      "schedule": "13 8 * * *"
    },
    {
      "path": "/api/cron?job=prune-visitor-data",
      "schedule": "37 4 * * *"
    },
    {
      "path": "/api/cron?job=vercel-deployment-cleanup&commit=1",
      "schedule": "19 4 * * *"
    }
  ],
  "functions": {
    "api/v/[slug].ts": {
      "includeFiles": "dist/index.html"
    }
  }
}
