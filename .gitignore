.vercel
.env*

# Playwright
/test-results/
/playwright-report/
/blob-report/

# Vite build output -- this IS the live deploy (vercel.json's
# outputDirectory/buildCommand). Regenerated by `bun run build`/`dev`/
# `preview` and by Vercel's own buildCommand at deploy time, so it no
# longer needs to be committed.
/dist/

# `bun run generate-config` output -- see config.toml's own header
# comment. Regenerated automatically before build/typecheck (package.json);
# run it by hand after editing config.toml without running one of those.
/src/data/config.generated.ts
/lib/config.generated.ts

# Ad hoc local review exports from one-off scripts -- not code, not meant to
# be committed. quarantine_commons_artist_field_issues.py writes this one.
/commons-artist-field-quality-review.csv

# Internal-only docs -- operational/business detail not meant for the public
# repo (org names, provider account specifics, restore runbooks, the full
# ticket-by-ticket build history). Kept on disk for internal reference; see
# AGENTS.md for what does ship publicly instead.
/CLAUDE.md
/INFRASTRUCTURE.md
/DISASTER-RECOVERY.md
/DECISION_LOG.md
/handover.md
.claude/
.vscode/

# Same category -- internal review/editorial workflow tracking (quarantine
# decisions, tea-voice batch review, per-ticket progress notes) and manual
# ops runbooks (AWS console setup). Not contributor-facing documentation.
/review/
/infra/

# Generated storyline-candidate review output (find_storyline_candidates.py)
# -- editorial triage artifacts with internal-tracker doc links baked in,
# same category as /review/ above, not source.
/python/ingest/candidate_clusters_*.json
/python/ingest/storyline_review_log.json

# Stray npm lockfile -- this project uses Bun (bun.lock is authoritative,
# see package.json's packageManager field), not npm.
/package-lock.json
